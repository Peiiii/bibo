{
  "name": "@nextclaw/bibo-hosted",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "scripts": {
    "tsc": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "tsx --test src/app/workspace-router.test.ts src/app/bibo-auth.utils.test.ts src/app/bibo-hosted.app.test.ts src/app/bibo-run-stream.utils.test.ts src/app/services/bibo-execution.service.test.ts src/app/utils/bibo-context-files.utils.test.ts src/app/services/bibo-conversation.service.test.ts src/app/migration/bibo-edge-export.service.test.ts src/app/migration/bibo-edge-migration.service.test.ts src/app/services/model/bibo-model.service.test.ts src/app/services/bibo-edge-web.service.test.ts src/app/stores/bibo-edge-session.store.test.ts src/app/stores/cloudflare-session.store.test.ts src/app/stores/bibo-space-file.store.test.ts src/app/stores/bibo-workspace.store.test.ts src/features/search/routes/bibo-search.route.test.ts src/features/bibo-domain/services/bibo-space.service.test.ts src/features/bibo-domain/tools/bibo-space.tools.test.ts src/features/space/utils/calendar.utils.test.ts src/features/space/stores/bibo-space.store.test.ts src/features/space/managers/file-editing.manager.test.ts src/features/chat/managers/bibo-conversation.manager.test.ts src/app/services/bibo-integration-keys.service.test.ts src/features/integrations/stores/integrations.store.test.ts scripts/deployment/deploy-origin.utils.test.ts",
    "test:self-hosted": "tsx --test src/app/utils/bibo-self-hosted-auth.utils.test.ts src/app/bibo-auth.utils.test.ts",
    "test:worker": "tsx --test src/app/stores/cloudflare-session-worker.store.test.ts src/app/testing/bibo-public-api.worker.test.ts",
    "build": "vite build --mode self-hosted",
    "dev": "vite --mode ui --host 127.0.0.1 --port 5188 --strictPort",
    "dev:worker": "wrangler dev",
    "dev:proxy": "vite --mode self-hosted --host 127.0.0.1 --port 5188 --strictPort",
    "deploy": "wrangler deploy",
    "build:hosted": "vite build",
    "preflight:deploy": "tsx scripts/deployment/deploy-preflight.controller.ts",
    "deploy:hosted": "pnpm preflight:deploy && pnpm -w build:hosted && pnpm preflight:deploy && wrangler deploy --config wrangler.hosted.toml --containers-rollout=none",
    "logs": "tsx scripts/diagnostics/bibo-logs.controller.ts",
    "test:diagnostics": "tsx --test src/app/bibo-hosted.app.test.ts src/app/diagnostics/bibo-diagnostics.utils.test.ts src/app/bibo-run-stream.utils.test.ts",
    "smoke:client": "pnpm build:client && tsx scripts/bibo-product.smoke.ts && tsx scripts/chat/bibo-question.smoke.ts",
    "smoke:markdown": "pnpm build:client && tsx scripts/bibo-markdown.smoke.ts && tsx scripts/bibo-markdown-chat.smoke.ts",
    "smoke:editor-loading": "pnpm build:client && tsx scripts/markdown-editor/bibo-editor-loading.smoke.ts",
    "smoke:editing": "pnpm build:client && tsx scripts/markdown-editor/bibo-editing-experience.smoke.ts",
    "smoke:inbox": "pnpm build:client && tsx scripts/inbox/bibo-inbox-layout.smoke.ts",
    "smoke:composer": "pnpm build:client && tsx scripts/bibo-composer.smoke.ts",
    "smoke:live": "tsx scripts/bibo-live.smoke.ts",
    "smoke:tasks": "tsx scripts/bibo-task-latency.smoke.ts",
    "smoke:routing": "pnpm build:client && tsx scripts/bibo-routing.smoke.ts",
    "smoke:planning": "tsx scripts/workspace-planning.smoke.ts",
    "smoke:feedback": "pnpm build:client && tsx scripts/workspace-resources.smoke.ts",
    "smoke:resources": "pnpm build:client && tsx scripts/workspace-resources.smoke.ts",
    "smoke:display": "pnpm build:client && tsx scripts/workspace/bibo-display.smoke.ts",
    "smoke:recovery": "pnpm build:client && tsx scripts/chat/bibo-run-recovery.smoke.ts",
    "build:client": "vite build",
    "deploy:worker": "pnpm deploy:hosted",
    "deploy:client": "pnpm deploy:hosted",
    "deploy:container": "pnpm preflight:deploy && pnpm build:hosted && pnpm preflight:deploy && wrangler deploy --config wrangler.hosted.toml"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.10",
    "@nextclaw/core": "0.18.8",
    "@nextclaw/harness": "0.2.31",
    "@nextclaw/kernel": "0.19.5",
    "@nextclaw/ncp": "0.11.3",
    "@nextclaw/ncp-agent-runtime-next": "0.1.31",
    "@nextclaw/ncp-toolkit": "0.6.28",
    "@nextclaw/shared": "0.8.4",
    "@nextclaw/bibo-api": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "5.20260921.1",
    "@nextclaw/bibo-client": "workspace:*",
    "@nextclaw/personal-agent-ui": "workspace:*",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.27.3",
    "lucide-react": "^0.462.0",
    "miniflare": "4.20260219.0",
    "playwright": "^1.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "4.138.0",
    "zustand": "^5.0.2"
  }
}
