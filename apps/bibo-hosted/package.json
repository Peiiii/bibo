{
  "name": "@nextclaw/bibo-hosted",
  "version": "0.2.1-beta.2",
  "private": true,
  "type": "module",
  "scripts": {
    "tsc": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "tsx --test src/app/workspace-router.test.ts src/app/bibo-auth.utils.test.ts src/app/bibo-hosted.app.test.ts src/app/bibo-run-stream.utils.test.ts src/app/services/bibo-execution.service.test.ts src/app/utils/bibo-context-files.utils.test.ts src/app/services/bibo-conversation.service.test.ts src/app/migration/bibo-edge-export.service.test.ts src/app/migration/bibo-edge-migration.service.test.ts src/app/services/model/bibo-model.service.test.ts src/app/services/bibo-edge-web.service.test.ts src/app/stores/bibo-edge-session.store.test.ts src/app/stores/cloudflare-session.store.test.ts src/app/stores/bibo-space-file.store.test.ts src/app/stores/bibo-workspace.store.test.ts src/features/search/routes/bibo-search.route.test.ts src/features/bibo-domain/services/bibo-space.service.test.ts src/features/bibo-domain/tools/bibo-space.tools.test.ts src/features/space/utils/calendar.utils.test.ts src/features/space/stores/bibo-space.store.test.ts src/features/space/managers/file-editing.manager.test.ts src/features/chat/managers/bibo-conversation.manager.test.ts",
    "test:self-hosted": "tsx --test src/app/utils/bibo-self-hosted-auth.utils.test.ts src/app/bibo-auth.utils.test.ts",
    "build": "vite build --mode self-hosted",
    "dev": "vite --mode ui --host 127.0.0.1 --port 5188 --strictPort",
    "dev:worker": "wrangler dev",
    "dev:proxy": "vite --mode self-hosted --host 127.0.0.1 --port 5188 --strictPort",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.10",
    "@nextclaw/core": "0.18.6-beta.1",
    "@nextclaw/harness": "0.2.28-beta.2",
    "@nextclaw/kernel": "0.19.2-beta.2",
    "@nextclaw/ncp": "0.11.3",
    "@nextclaw/ncp-agent-runtime-next": "0.1.30-beta.0",
    "@nextclaw/ncp-toolkit": "0.6.28",
    "@nextclaw/shared": "0.8.4"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "5.20260921.1",
    "@nextclaw/bibo-client": "workspace:*",
    "@nextclaw/personal-agent-ui": "workspace:*",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.27.3",
    "lucide-react": "^0.462.0",
    "playwright": "^1.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "4.138.0",
    "zustand": "^5.0.2"
  }
}
